# WGS-FMT-Agent v2 production configuration template.
# Copy to .env, replace every CHANGE_ME value, and keep .env out of Git.

# -----------------------------------------------------------------------------
# Runtime paths (Linux deployment)
# -----------------------------------------------------------------------------
WGS_ENV=production
WGS_ENV_ROOT=/storage/main/users/zhangrongpeng/data/fmt/runtime/envs/wgs-fmt-agent-v2
WGS_WORKSPACE=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data
WGS_ARTIFACT_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/artifacts
WGS_MODEL_REGISTRY_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/model-registry
WGS_RESULTS_DIR=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/results
WGS_AGENT_CONFIG_DIR=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/agent-config
WGS_AGENT_AUDIT_DIR=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/audit
WGS_AGENT_SANDBOX_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/sandboxes
WGS_SANDBOX_ALLOWED_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data
WGS_SANDBOX_READ_MAX_BYTES=524288
WGS_SANDBOX_WRITE_MAX_BYTES=524288
WGS_CANVAS_MAX_BYTES=20971520

# Root for portable bioinformatics environments and reference databases.
WGS_FMT_RESOURCE_ROOT=/storage/main/users/zhangrongpeng/data/fmt
FMT_ROOT=/storage/main/users/zhangrongpeng/data/fmt
ENV_ROOT=/storage/main/users/zhangrongpeng/data/fmt/runtime/envs
DB_ROOT=/storage/main/users/zhangrongpeng/data/fmt/databases

# Sample upload and bioinformatics pipeline
WGS_UPLOAD_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/uploads
WGS_UPLOAD_JOB_ROOT=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/upload-jobs
WGS_BIOINFORMATICS_OUTPUT_ROOT=/storage/main/users/zhangrongpeng/data/fmt/postfmt_processed
# Optional override. When omitted, the worker bundled in this repository is used.
# WGS_BIOINFORMATICS_WORKER=/opt/fmt-healthcare-agent/runtime/scripts/postfmt_pipeline/process_postfmt_sample.sh
WGS_RUNNER_STATUS=/storage/main/users/zhangrongpeng/data/fmt/postfmt_processed/status/runner_status.tsv
WGS_UPLOAD_THREADS=4
WGS_MPROJECT_BIN=mProject
WGS_MPROJECT_DATABASE=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/databases/human-gut

# This reverse tunnel is specific to the current computing platform. Disable it
# on a normal server that exposes 8502 directly or uses Nginx/Traefik.
WGS_ENABLE_REVERSE_TUNNELS=true
FMT_JUMP_HOST=zhangrongpeng@10.181.9.172
FMT_TUNNEL_KEY=/storage/main/users/zhangrongpeng/.ssh/id_rsa_jump
FMT_SSH_REMOTE_PORT=20013
FMT_WEB_REMOTE_PORT=18502
FMT_API_REMOTE_PORT=18503

# -----------------------------------------------------------------------------
# Persistence and memory
# -----------------------------------------------------------------------------
# Primary application database. Replace both CHANGE_ME values before enabling.
WGS_DATABASE_URL=mysql+pymysql://wgs_fmt:CHANGE_ME@127.0.0.1:3306/wgs_fmt
WGS_MYSQL_URL=mysql+pymysql://wgs_fmt:CHANGE_ME@127.0.0.1:3306/wgs_fmt
WGS_MYSQL_POOL_SIZE=10

# Local SQLite remains useful for the LitKG cache/index metadata.
WGS_KNOWLEDGE_DB=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/knowledge/kb.db
WGS_METADATA_DATABASE_URL=sqlite:////storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/metadata.db

WGS_REDIS_URL=redis://127.0.0.1:6379/0
WGS_MEMORY_SHORT_TTL_SECONDS=86400
WGS_MEMORY_LONG_TTL_SECONDS=0

# Managed local Docker node; set false for an independently managed instance.
WGS_ELASTICSEARCH_MANAGED=true
WGS_ELASTICSEARCH_VERSION=8.19.23
WGS_ELASTICSEARCH_MEMORY=2g
WGS_ELASTICSEARCH_HEAP=512m
WGS_ELASTICSEARCH_START_TIMEOUT=120
# WGS_ELASTICSEARCH_DOCKER_SOCKET=/run/user/1000/docker.sock
WGS_ELASTICSEARCH_URL=http://127.0.0.1:9200
WGS_ELASTICSEARCH_INDEX=wgs-knowledge
WGS_ELASTICSEARCH_API_KEY=
# WGS_ELASTICSEARCH_USERNAME=your-user
# WGS_ELASTICSEARCH_PASSWORD_FILE=/absolute/path/to/private-password-file
WGS_EMBEDDING_DIMENSIONS=384
WGS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# LitKG Claim/relationship retrieval
# -----------------------------------------------------------------------------
WGS_CLAIM_API_URL=http://10.181.8.92:8080
WGS_CLAIM_API_TOKEN=CHANGE_ME
WGS_CLAIM_API_OPENAPI_PATH=/openapi.json
WGS_CLAIM_API_SEARCH_PATH=
WGS_CLAIM_API_SEARCH_METHOD=AUTO
WGS_CLAIM_API_VERSION_PATH=
WGS_CLAIM_API_TIMEOUT=20
# Agent knowledge retrieval uses /ask with generate=false. Set the actual KB ID below.
WGS_CLAIM_API_ASK_HOPS=1
# Explicit opt-in only; local results are labelled as degraded, never LitKG evidence.
WGS_CLAIM_API_LOCAL_FALLBACK=false
WGS_CLAIM_API_KNOWLEDGE_BASE_ID=7
WGS_CLAIM_API_SCAN_LIMIT=1000
WGS_CLAIM_API_STARTUP_PROBE=true
WGS_CLAIM_API_PROBE_REQUIRED=false
WGS_GRAPH_TEXT_SEARCH_PATH=/api/knowledge-bases/{knowledge_base_id}/claims
WGS_DEFAULT_KNOWLEDGE_VERSION=current

# -----------------------------------------------------------------------------
# Model service and Agent daemon
# -----------------------------------------------------------------------------
WGS_HOST=127.0.0.1
WGS_PORT=7438
WGS_LOG_LEVEL=INFO
WGS_LOG_FORMAT=json
WGS_LOG_FILE=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/logs/agent-core.log
WGS_TRACE_ENABLED=true
WGS_TRACE_FILE=/storage/main/users/zhangrongpeng/data/fmt/wgs-fmt-agent-v2-data/traces/daemon.jsonl
WGS_PERMISSION_TIMEOUT=60

WGS_LLM_PROVIDER=deepseek
WGS_LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME

# Optional OpenAI-compatible local model service
WGS_LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
WGS_LOCAL_LLM_API_KEY=local-no-key-required

# Optional providers/services
ANTHROPIC_API_KEY=
PUBMED_API_KEY=
PUBMED_EMAIL=

# -----------------------------------------------------------------------------
# Versioned model/report workflow
# -----------------------------------------------------------------------------
WGS_DEFAULT_MODEL_VERSION=baseline-v1
WGS_FEATURE_SCHEMA_VERSION=feature-schema-v1
WGS_REPORT_TEMPLATE_VERSION=report-template-v1
WGS_WORKFLOW_ENGINE=local
WGS_NEXTFLOW_BIN=nextflow
WGS_NEXTFLOW_PIPELINE=/storage/main/users/zhangrongpeng/data/fmt/apps/WGS-FMT-Agent-v2/workflows/main.nf
