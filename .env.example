WGS_ENV=development
WGS_WORKSPACE=./var
WGS_FMT_RESOURCE_ROOT=./var
FMT_ROOT=./var
ENV_ROOT=./var/runtime/envs
DB_ROOT=./var/databases
WGS_UPLOAD_ROOT=./var/uploads
WGS_UPLOAD_JOB_ROOT=./var/upload-jobs
WGS_BIOINFORMATICS_OUTPUT_ROOT=./var/postfmt_processed
WGS_UPLOAD_THREADS=4
WGS_ENABLE_REVERSE_TUNNELS=false
WGS_MPROJECT_BIN=mProject
WGS_MPROJECT_DATABASE=./var/databases/human-gut
WGS_CLAIM_API_URL=http://10.181.8.92:8080
WGS_CLAIM_API_TOKEN=
WGS_CLAIM_API_OPENAPI_PATH=/openapi.json
# 留空时从 OpenAPI 自动发现 Claim 路由
WGS_CLAIM_API_SEARCH_PATH=
WGS_CLAIM_API_SEARCH_METHOD=AUTO
WGS_CLAIM_API_VERSION_PATH=
WGS_CLAIM_API_TIMEOUT=20
WGS_CLAIM_API_KNOWLEDGE_BASE_ID=7
# auto discovers every LitKG knowledge base; use comma-separated IDs to restrict it.
WGS_CLAIM_API_KNOWLEDGE_BASE_IDS=auto
WGS_CLAIM_API_SCAN_LIMIT=1000
WGS_CLAIM_API_STARTUP_PROBE=true
WGS_CLAIM_API_PROBE_REQUIRED=false
WGS_DEFAULT_KNOWLEDGE_VERSION=current
WGS_DEFAULT_MODEL_VERSION=baseline-v1
WGS_FEATURE_SCHEMA_VERSION=feature-schema-v1
WGS_REPORT_TEMPLATE_VERSION=report-template-v1
WGS_METADATA_DATABASE_URL=postgresql://wgs:wgs@127.0.0.1:5432/wgs
# Backend persistence, memory, and hybrid knowledge retrieval
WGS_MYSQL_URL=mysql+pymysql://wgs:change-me@127.0.0.1:3306/wgs_fmt
WGS_MYSQL_POOL_SIZE=10
WGS_REDIS_URL=redis://127.0.0.1:6379/0
WGS_MEMORY_SHORT_TTL_SECONDS=86400
# 0 means persistent until explicitly deleted
WGS_MEMORY_LONG_TTL_SECONDS=0
WGS_ELASTICSEARCH_URL=http://127.0.0.1:9200
WGS_ELASTICSEARCH_INDEX=wgs-knowledge
WGS_ELASTICSEARCH_API_KEY=
WGS_EMBEDDING_DIMENSIONS=384
WGS_GRAPH_TEXT_SEARCH_PATH=/knowledge-bases/{knowledge_base_id}/relations
WGS_ARTIFACT_ROOT=./var/artifacts
WGS_WORKFLOW_ENGINE=local
WGS_NEXTFLOW_BIN=nextflow
WGS_NEXTFLOW_PIPELINE=./workflows/main.nf
WGS_MODEL_REGISTRY_ROOT=./var/model-registry

# Retained agent runtime, CLI/TUI, and Streamlit application
WGS_HOST=127.0.0.1
WGS_PORT=7438
WGS_LOG_LEVEL=INFO
WGS_LOG_FILE=./var/logs/agent-core.log
WGS_LOG_FORMAT=text
WGS_LLM_PROVIDER=deepseek
WGS_LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
WGS_DATA_DIR=./data
WGS_REFERENCE_DIR=./data/reference
WGS_RESULTS_DIR=./data/results
WGS_KB_DIR=./knowledge_base/documents
WGS_KB_INDEX_DIR=./knowledge_base/faiss_index
WGS_KB_SQLITE_PATH=./knowledge_base/kb.db
WGS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PUBMED_API_KEY=
PUBMED_EMAIL=
WGS_PERMISSION_TIMEOUT=60
WGS_POLICY_FILE=./var/policy.toml
WGS_TRACE_ENABLED=true
WGS_TRACE_FILE=./var/traces/daemon.jsonl
STREAMLIT_PORT=8501
