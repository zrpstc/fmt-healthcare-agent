# Single server: browser -> http://<server-ip>:8502 -> local API on 8503.
WGS_ENV=development
WGS_WEB_HOST=0.0.0.0
WGS_WEB_PORT=8502
WGS_API_PORT=8503
# Only needed for a separate frontend origin; comma-separated explicit origins.
WGS_CORS_ORIGINS=

# Relative paths are resolved from the repository root, not the shell directory.
# All omitted runtime paths are derived from this root.
WGS_WORKSPACE=./var
WGS_ENV_ROOT=./.venv
# Optional overrides (omit to follow WGS_WORKSPACE):
# WGS_RESULTS_DIR=./var/results
# WGS_CONVERSATION_DB_FILE=./var/db/wgs_agent.db
# WGS_AGENT_CONFIG_DIR=./var/agent-config
# WGS_AGENT_SANDBOX_ROOT=./var/sandboxes
# WGS_AGENT_AUDIT_DIR=./var/agent-audit
# WGS_KB_SQLITE_PATH=./var/knowledge/kb.db
# WGS_KB_DIR=./var/knowledge/documents
# WGS_KB_INDEX_DIR=./var/knowledge/index
# WGS_REFERENCE_DIR=./var/reference
# Optional versioned healthy stool cohort (manifest.json, metadata.tsv, species_abundance.tsv).
# See docs/HEALTHY_POPULATION_CONTROL.md. An explicitly configured invalid cohort disables comparison.
# WGS_HEALTHY_REFERENCE_DIR=./var/reference/healthy
# WGS_UPLOAD_ROOT=./var/uploads
# WGS_UPLOAD_JOB_ROOT=./var/upload-jobs
# WGS_BIOINFORMATICS_OUTPUT_ROOT=./var/bioinformatics
# The worker is bundled; install its analysis environments and databases separately.
# WGS_BIOINFORMATICS_WORKER=./runtime/scripts/postfmt_pipeline/process_postfmt_sample.sh
WGS_UPLOAD_THREADS=4
# Optional portable resource bundle root; use the same root for both variables.
# WGS_FMT_RESOURCE_ROOT=/srv/wgs-fmt
# FMT_ROOT=/srv/wgs-fmt
# ENV_ROOT=/srv/wgs-fmt/runtime/envs
# DB_ROOT=/srv/wgs-fmt/databases
# WGS_PIPELINE_ROOT=./runtime/pipeline
# WGS_CONDA_ACTIVATE=/absolute/path/to/miniconda3/bin/activate

WGS_MPROJECT_BIN=mProject
# WGS_MPROJECT_DATABASE=./var/databases/human-gut
WGS_CLAIM_API_URL=http://127.0.0.1:8080
WGS_CLAIM_API_TOKEN=
WGS_CLAIM_API_OPENAPI_PATH=/openapi.json
WGS_CLAIM_API_SEARCH_PATH=
WGS_CLAIM_API_SEARCH_METHOD=AUTO
WGS_CLAIM_API_VERSION_PATH=
WGS_CLAIM_API_TIMEOUT=20
# Agent knowledge retrieval uses /ask with generate=false. Set the actual KB ID below.
WGS_CLAIM_API_ASK_HOPS=1
# Explicit opt-in only; local results are labelled as degraded, never LitKG evidence.
WGS_CLAIM_API_LOCAL_FALLBACK=false
WGS_CLAIM_API_KNOWLEDGE_BASE_ID=7
WGS_CLAIM_API_SCAN_LIMIT=1000
WGS_CLAIM_API_STARTUP_PROBE=true
WGS_CLAIM_API_PROBE_REQUIRED=false
WGS_DEFAULT_KNOWLEDGE_VERSION=current
WGS_DEFAULT_MODEL_VERSION=baseline-v1
WGS_FEATURE_SCHEMA_VERSION=feature-schema-v1
WGS_REPORT_TEMPLATE_VERSION=report-template-v1

# Health report narration reuses the workspace model unless both overrides are set.
# WGS_REPORT_LLM_BASE_URL=http://127.0.0.1:30000/v1
# WGS_REPORT_LLM_MODEL=your-served-model
# WGS_REPORT_LLM_API_KEY=
WGS_REPORT_RESPONSE_FORMAT=json_object
WGS_REPORT_MAX_TOKENS=8192
WGS_REPORT_LLM_CONCURRENCY=2
WGS_REPORT_TIMEOUT_SECONDS=180
# Next's external rewrite timeout must cover multi-batch report generation.
WGS_WEB_PROXY_TIMEOUT_MS=900000

# Conversations/auth use local SQLite by default. Optional local services:
# WGS_DATABASE_URL=mysql+pymysql://wgs:change-me@127.0.0.1:3306/wgs_fmt
WGS_MYSQL_POOL_SIZE=10
WGS_REDIS_URL=redis://127.0.0.1:6379/0
WGS_MEMORY_SHORT_TTL_SECONDS=86400
WGS_MEMORY_LONG_TTL_SECONDS=0
# deploy/start.sh manages a local authenticated Docker instance by default.
# Set false to use an existing service and its URL/API key instead.
WGS_ELASTICSEARCH_MANAGED=true
WGS_ELASTICSEARCH_VERSION=8.19.23
WGS_ELASTICSEARCH_MEMORY=2g
WGS_ELASTICSEARCH_HEAP=512m
WGS_ELASTICSEARCH_START_TIMEOUT=120
# For rootless Docker, specify its local socket here.
# WGS_ELASTICSEARCH_DOCKER_SOCKET=/run/user/1000/docker.sock
WGS_ELASTICSEARCH_URL=http://127.0.0.1:9200
WGS_ELASTICSEARCH_INDEX=wgs-knowledge
WGS_ELASTICSEARCH_API_KEY=
# For an external instance using basic auth (API key takes precedence):
# WGS_ELASTICSEARCH_USERNAME=your-user
# WGS_ELASTICSEARCH_PASSWORD_FILE=/absolute/path/to/private-password-file
WGS_EMBEDDING_DIMENSIONS=384
WGS_GRAPH_TEXT_SEARCH_PATH=/api/knowledge-bases/{knowledge_base_id}/claims
WGS_WORKFLOW_ENGINE=local
WGS_NEXTFLOW_BIN=nextflow
WGS_NEXTFLOW_PIPELINE=./workflows/main.nf

WGS_HOST=127.0.0.1
WGS_PORT=7438
WGS_LOG_LEVEL=INFO
WGS_LOG_FORMAT=text
WGS_LLM_PROVIDER=deepseek
WGS_LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_API_KEY=
WGS_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
WGS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PUBMED_API_KEY=
PUBMED_EMAIL=
WGS_PERMISSION_TIMEOUT_S=60
WGS_TRACE_ENABLED=true
